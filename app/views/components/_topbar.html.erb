
  <div class="topbar">
    <%= link_to root_path, class: "logo-container" do %>
      <%= image_tag "logo-black.svg" %>
    <% end %>
    <%= link_to root_path, class: "home-container" do %>
      <%= image_tag "home.svg" %>
    <% end %>
    
    <% if false %>
      <%= link_to "denuncia global", section_path("Denuncia-Global"), class: "topbar__link" %>
      <a href="" class="topbar__link popup" onmouseover="popup(this)" onmouseout="popupout(this)">
        tráfico san luis
        <span class="popuptext" id="myPopup">Próximamente</span>
      </a>
    <% end %>

<div class="d-flex overflow-hidden" style="gap: 8px; align-items: center;">
  <% locations = Location.where(key: ['san-luis', 'vallartabahia', 'zacatecas', 'leon', 'queretaro']) %>
  <% current_key = request.subdomains.first || 'san-luis' %>

  <% visible_locations = locations.reject { |loc| loc.key == current_key } %>

  <% visible_locations.each_with_index do |loc, index| %>
    <% if loc.key == 'san-luis' %>
      <% url = "https://globalmedia.mx" %>
    <% else %>
      <% url = "https://#{loc.key}.globalmedia.mx" %>
    <% end %>

    <span class="location" onclick="window.location.href='<%= url %>'" style="cursor: pointer; font-weight: bold;">
      <%= loc.name %>
    </span>

    <%# Agrega el separador " | " excepto después del último %>
    <% if index < visible_locations.size - 1 %>
      <span style="font-weight: bold;">|</span>
    <% end %>
  <% end %>
</div>



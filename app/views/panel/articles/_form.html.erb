<form id="fields-for-s3">
  <% @s3_direct_post.fields.map do |name, value| %>
    <input type="hidden" name="<%= name %>" value="<%= value %>" />
  <% end %>
</form>

<%= form_for [:panel, @article], multipart: true, html: { class: "directUpload", remote: true, data: { 'form-data' => (@s3_direct_post.fields), 'url' => @s3_direct_post.url, 'host' => URI.parse(@s3_direct_post.url).host } } do |f| %>
  <% if @article.errors.any? %>  
    <div class="card">
      <h5><%= pluralize(@article.errors.count, "error") %></h5>
      <ul>
        <% @article.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="card admin-form form--article">
    <% if current_user.video_complaints_permission? %>
      <div class="field field--string">
        <label>Sección</label>
        <%= f.select :articable_id, options_for_select(Section.all.collect{ |u| [u.name, u.id] }, @article.articable_id) %>
        <%= f.hidden_field :articable_type, value: "Section" %>
      </div>
    <% else %>
      <div class="field field--string">
        <label>Sección</label>
        <%= f.select :articable_id, options_for_select(Section.where("name != 'Denuncia Global'").collect{ |u| [u.name, u.id] }, @article.articable_id) %>
        <%= f.hidden_field :articable_type, value: "Section" %>
      </div>
    <% end %>

    <% if Author.all.count > 0 %>
      <div class="field field--string">
        <label>Autor de la Nota</label>
        <%= f.select :author_id, options_for_select(Author.all.collect{ |u| [u.name, u.id] }, @article.author_id), prompt: "Selecciona un Autor" %> 
      </div>
    <% end %>  

    <div class="field field--datetime">
      <label>Fecha programada:</label>
      <div class="field">
        <%= f.datetime_select :scheduled_time, datetime_separator: "<span>-</span>", time_separator: "<span>:</span>" %>
      </div>
    </div>

    <% if current_user.is_news_chief? %>
      <div class="field field--string">
        <label for="">Estatus de la nota</label>
        <%= f.select :draft, options_for_select([['Borrador', 0], ['Aprobado', 1], ['No Aprobado', -1], ['Publicar', 2]], @article.draft) %>
      </div>
    <% end %>

    <div class="field field--string">
      <label>Título de la Nota</label>
      <%= f.text_field :name, max_chars: 120, required: true, data: { max_chars: 120 } %>
    </div>

    <div class="field">
      <label>Extracto</label>
      <%= f.text_area :short_description, required: true, data: { max_chars: 150 } %>
    </div>

    <% if @article.image %>
      <div class="field field--string">
        <% if @article.image != "" %>
          <%= image_tag @article.image, class: "form__image-preview shown" %>
        <% end %>
        <label>Imagen principal actual</label>
        <input type="text" disabled value="<%= @article.image %>">
      </div>  
    <% end %>

	<div id="note-editor"></div>
	<%= f.hidden_field :note, id: 'article_note' %>

    <div class="field">
      <label>Exclusiva</label>
      <%= f.select :exclusive, options_for_select([['Sí, esta nota es exclusiva', true], ['No, esta nota no es exclusiva', false]], @article.exclusive) %>
    </div>

    <div class="field">
      <label>Hashtags: </label>
      <%= f.autocomplete_field(:hashtags_names, autocomplete_hashtag_name_panel_hashtags_path, id_element: 'hashtags', class: "search-bar", placeholder: "Por ejemplo: TECNOLOGÍA, PROGRAMACIÓN, NOTICIAS, MÉXICO", type: "search", value: @hashtags, "data-delimiter": ', ', id: 'hashtags') %>
    </div>

    <div class="field field--string">
      <label>Imagen principal</label>
      <%= f.file_field :image, required: true %>
    </div>


  <div class="field field--string">
    <label>Metatags:</label>
    <%= f.text_field :meta_tags, id: "meta_tags", maxlength: "100" %>
    <span id="meta-tags-counter" class="char-counter" style="display:block;font-size:0.8em;color:#666;">0/3 palabras</span>
  </div>

    <div class="field field--checkbox">
      <label>Último momento:</label>
      <%= f.check_box :breaking_news, id: "breaking_news" %>
    </div>
  </div>
<% end %>
<!-- Scripts necesarios de redes -->
<script async src="https://platform.twitter.com/widgets.js" charset="utf-8"></script>
<script async src="//www.instagram.com/embed.js"></script>
<script async src="https://www.tiktok.com/embed.js"></script>

<!-- Quill -->
<link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
<script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>


<script>
// Código simplificado - SIN lógica de Turbolinks
document.addEventListener('DOMContentLoaded', function() {
  console.log('Inicializando formulario de artículo...');
  
  // Verificar que todos los elementos necesarios existen
  const noteEditor = document.getElementById('note-editor');
  const articleName = document.getElementById('article_name');
  const shortDescription = document.getElementById('article_short_description');
  
  if (!noteEditor || !articleName || !shortDescription) {
    console.warn('Elementos del formulario no encontrados');
    return;
  }

  // Inicializar Quill solo si no existe
  if (typeof window.editor === 'undefined' || window.editor === null) {
    initializeQuillEditor();
  }
  
  // Inicializar contadores
  initializeCounters();
  initializeImagePreviews();
  initializeMetaTagsCounter();
});

function initializeQuillEditor() {
  const BlockEmbed = Quill.import('blots/block/embed');

  // === Tweet Blot ===
  class TweetBlot extends BlockEmbed {
    static create(url) {
      const node = super.create();
      node.innerHTML = `<blockquote class="twitter-tweet"><a href="${url}"></a></blockquote>`;
      if (typeof twttr !== 'undefined') {
        twttr.widgets.load(node);
      }
      return node;
    }

    static value(node) {
      const anchor = node.querySelector('a');
      return anchor ? anchor.getAttribute('href') : '';
    }
  }
  TweetBlot.blotName = 'tweet';
  TweetBlot.tagName = 'div';
  TweetBlot.className = 'tweet-embed';
  Quill.register(TweetBlot);

  // === Instagram Blot ===
  class InstagramBlot extends BlockEmbed {
    static create(url) {
      const node = super.create();
      node.innerHTML = `<blockquote class="instagram-media" data-instgrm-permalink="${url}" data-instgrm-version="12"></blockquote>`;
      if (window.instgrm) {
        window.instgrm.Embeds.process(node);
      }
      return node;
    }

    static value(node) {
      return node.querySelector('blockquote')?.getAttribute('data-instgrm-permalink');
    }
  }
  InstagramBlot.blotName = 'instagram';
  InstagramBlot.tagName = 'div';
  InstagramBlot.className = 'instagram-embed';
  Quill.register(InstagramBlot);

  // === TikTok Blot ===
  class TikTokBlot extends BlockEmbed {
    static create(url) {
      const node = super.create();
      const videoId = url.split('/').filter(Boolean).pop();
      node.innerHTML = `
        <blockquote class="tiktok-embed" cite="${url}" data-video-id="${videoId}" style="max-width: 325px;"><section></section></blockquote>
      `;
      const script = document.createElement('script');
      script.src = 'https://www.tiktok.com/embed.js';
      script.async = true;
      node.appendChild(script);
      return node;
    }

    static value(node) {
      return node.querySelector('blockquote')?.getAttribute('cite');
    }
  }
  TikTokBlot.blotName = 'tiktok';
  TikTokBlot.tagName = 'div';
  TikTokBlot.className = 'tiktok-embed';
  Quill.register(TikTokBlot);

  // === Inicialización de Quill ===
  window.editor = new Quill('#note-editor', {
    theme: 'snow',
    modules: {
      toolbar: [
        [{ 'header': [1, 2, 3, 4, 5, 6, false] }],
        ['bold', 'italic', 'underline', 'strike'],
        ['blockquote', 'code-block', 'video', 'image', 'link'],
        ['tweet', 'instagram', 'tiktok'],
        [{ 'list': 'ordered'}, { 'list': 'bullet' }],
        [{ 'indent': '-1'}, { 'indent': '+1' }],
        [{ 'align': [] }],
        [{ 'color': [] }, { 'background': [] }],
        [{ 'font': [] }],
        [{ 'size': ['small', false, 'large', 'huge'] }],
        ['clean']
      ],
      clipboard: {
        matchVisual: false
      }
    },
    placeholder: 'Escribe el contenido de tu artículo aquí...'
  });

  // === Handlers para insertar embeds ===
  const toolbar = window.editor.getModule('toolbar');
  toolbar.addHandler('tweet', function() {
    const url = prompt('Pega el enlace del Tweet:');
    if (url) {
      window.editor.insertEmbed(window.editor.getSelection().index, 'tweet', url);
    }
  });
  toolbar.addHandler('instagram', function() {
    const url = prompt('Pega el enlace del post de Instagram:');
    if (url) {
      window.editor.insertEmbed(window.editor.getSelection().index, 'instagram', url);
    }
  });
  toolbar.addHandler('tiktok', function() {
    const url = prompt('Pega el enlace del video de TikTok:');
    if (url) {
      window.editor.insertEmbed(window.editor.getSelection().index, 'tiktok', url);
    }
  });


<% if @article&.note.present? %>
  try {
    // Esperar a que Quill esté completamente inicializado
    setTimeout(() => {
      if (window.editor) {
        const noteContent = <%= raw(@article.note.to_json) %>;
        if (noteContent && noteContent.ops) {
          window.editor.setContents(noteContent);
        } else if (typeof noteContent === 'string') {
          // Si es HTML en lugar de Delta
          window.editor.root.innerHTML = noteContent;
        }
      }
    }, 100);
  } catch(e) {
    console.error("Error cargando contenido existente:", e);
  }
<% end %>

  // === Manejo del submit del formulario ===
  const form = document.querySelector('form.directUpload');
  if (form) {
    form.addEventListener('submit', function(e) {
      const contentField = document.querySelector('#article_note');
      if (contentField && window.editor) {
        contentField.value = JSON.stringify({
          html: window.editor.root.innerHTML,
          delta: window.editor.getContents()
        });
      }
      return true;
    });
  }
}

function initializeCounters() {
  // Contador para título
  const titleInput = document.getElementById('article_name');
  const excerptInput = document.getElementById('article_short_description');
  
  if (titleInput) {
    // Crear contador de título si no existe
    if (!document.getElementById('title-counter')) {
      const titleCounter = document.createElement('span');
      titleCounter.id = 'title-counter';
      titleCounter.className = 'char-counter';
      titleCounter.style.cssText = 'display:block;font-size:0.8em;color:#666;';
      titleInput.parentNode.appendChild(titleCounter);
    }
    
    const updateTitleCounter = function() {
      const length = this.value.length;
      const counter = document.getElementById('title-counter');
      if (counter) {
        counter.textContent = length + '/120';
        if (length > 120) {
          this.value = this.value.substring(0, 120);
          counter.textContent = '120/120';
        }
      }
    };
    
    titleInput.addEventListener('input', updateTitleCounter);
    updateTitleCounter.call(titleInput);
  }
  
  if (excerptInput) {
    // Crear contador de extracto si no existe
    if (!document.getElementById('excerpt-counter')) {
      const excerptCounter = document.createElement('span');
      excerptCounter.id = 'excerpt-counter';
      excerptCounter.className = 'char-counter';
      excerptCounter.style.cssText = 'display:block;font-size:0.8em;color:#666;';
      excerptInput.parentNode.appendChild(excerptCounter);
    }
    
    const updateExcerptCounter = function() {
      const length = this.value.length;
      const counter = document.getElementById('excerpt-counter');
      if (counter) {
        counter.textContent = length + '/150';
        if (length > 150) {
          this.value = this.value.substring(0, 150);
          counter.textContent = '150/150';
        }
      }
    };
    
    excerptInput.addEventListener('input', updateExcerptCounter);
    updateExcerptCounter.call(excerptInput);
  }
}

function initializeImagePreviews() {
  document.querySelectorAll('input[type=file]').forEach(function(input) {
    const field = input.closest('.field');
    if (field && !field.querySelector('.form__image-preview')) {
      const img = document.createElement('img');
      img.className = 'form__image-preview';
      img.style.cssText = 'display:none;max-width:100%;max-height:150px;margin-bottom:10px;border:1px solid #ddd;';
      input.parentNode.insertBefore(img, input);
    }
    
    input.addEventListener('change', function() {
      if (this.files && this.files[0]) {
        const reader = new FileReader();
        reader.onload = function(e) {
          const img = field.querySelector('.form__image-preview');
          if (img) {
            img.src = e.target.result;
            img.style.display = 'block';
          }
        };
        reader.readAsDataURL(this.files[0]);
      }
    });
  });
}

function initializeMetaTagsCounter() {
  const metaTagsInput = document.getElementById('meta_tags');
  const metaTagsCounter = document.getElementById('meta-tags-counter');
  
  if (metaTagsInput && metaTagsCounter) {
    const updateMetaTagsCounter = function() {
      const text = this.value;
      const words = text.trim() === '' ? 0 : text.trim().split(/\s+/).length;
      
      if (words > 3) {
        const wordsArray = text.trim().split(/\s+/).slice(0, 3);
        this.value = wordsArray.join(' ');
        metaTagsCounter.textContent = '3/3 palabras (límite alcanzado)';
        metaTagsCounter.style.color = '#e74c3c';
      } else {
        metaTagsCounter.textContent = words + '/3 palabras';
        metaTagsCounter.style.color = words === 3 ? '#e74c3c' : '#666';
      }
    };
    
    metaTagsInput.addEventListener('input', updateMetaTagsCounter);
    updateMetaTagsCounter.call(metaTagsInput);
  }
}

// SOLO DOMContentLoaded - SIN Turbolinks
document.addEventListener('DOMContentLoaded', function() {
  console.log('Inicializando formulario de artículo...');
  
  const noteEditor = document.getElementById('note-editor');
  const articleName = document.getElementById('article_name');
  const shortDescription = document.getElementById('article_short_description');
  
  if (!noteEditor || !articleName || !shortDescription) {
    console.warn('Elementos del formulario no encontrados');
    return;
  }

  if (typeof window.editor === 'undefined' || window.editor === null) {
    initializeQuillEditor();
  }
  
  initializeCounters();
  initializeImagePreviews();
  initializeMetaTagsCounter();
});
</script>

<%= render "components/s3_form_js" %>

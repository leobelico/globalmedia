<div class="panel__header">
	<h2 class="title panel__title"><span class="current">Autores</span></h2>
	<div class="panel__actions">
		<%= link_to "Nuevo Autor", new_panel_author_path, class: "button" %>
	</div>
</div>

<div class="table card">
	<div class="table__row">
		<p class="table__cell">Nombre:</p>
		<div class="table__image">Imagen:</div>
		<p class="table__cell">Fecha de creación:</p>
		<p class="table__cell">Artículos:</p>
		<p class="table__cell">Editar:</p>
		<p class="table__cell">Delete:</p>
	</div>
	<% @authors.each do |author| %>
		<div class="table__row">
			<%= link_to author.name, panel_author_path(author), class: "table__cell" %>
			<img src="<%= author.logo %>" alt="<%= author.name %>" class="table__image">
			<p class="table__cell"><%= author.created_at.strftime("%A, %d %b %Y %l:%M %p") %></p>
			<p class="table__cell"><%= author.articles.count %></p>
			<%= link_to "Editar", edit_panel_author_path(author), class: "table__cell edit" %>
			<%= link_to "Delete", panel_author_path(author), method: :delete, data: { confirm: "¿Estas seguro de querer eliminar el autor? Esta acción no se puede deshacer." }, class: "table__cell delete" %>
		</div>
	<% end %>	
</div>

<!-- PAGINACIÓN - AQUÍ VA -->
<div class="pagination">
  <%= will_paginate @authors %>
</div>
<style>
.pagination {
  text-align: center;
  margin: 30px 0;
  padding: 20px;
}

.pagination a, 
.pagination span {
  display: inline-block;
  padding: 8px 16px;
  margin: 0 4px;
  border: 1px solid #ddd;
  border-radius: 4px;
  text-decoration: none;
  color: #333;
  background: white;
  transition: all 0.3s ease;
}

.pagination .current {
  background-color: #007bff;
  color: white;
  border-color: #007bff;
}

.pagination a:hover {
  background-color: #f8f9fa;
  border-color: #007bff;
}

.pagination .disabled {
  color: #6c757d;
  pointer-events: none;
  background-color: #f8f9fa;
}
</style>
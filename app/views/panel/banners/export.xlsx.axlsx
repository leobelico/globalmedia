wb = xlsx_package.workbook

s = wb.styles
h  = s.add_style(bg_color: "1F3864", fg_color: "FFFFFF", font_name: "Arial", sz: 11, b: true, alignment: { horizontal: :center, vertical: :center })
d  = s.add_style(font_name: "Arial", sz: 10, alignment: { horizontal: :center, vertical: :center })
dl = s.add_style(font_name: "Arial", sz: 10, alignment: { horizontal: :left, vertical: :center })
a  = s.add_style(bg_color: "F2F2F2", font_name: "Arial", sz: 10, alignment: { horizontal: :center, vertical: :center })
al = s.add_style(bg_color: "F2F2F2", font_name: "Arial", sz: 10, alignment: { horizontal: :left, vertical: :center })
t  = s.add_style(bg_color: "D6E4F0", fg_color: "1F3864", font_name: "Arial", sz: 10, b: true, alignment: { horizontal: :center, vertical: :center })
g  = s.add_style(bg_color: "E2EFDA", fg_color: "375623", font_name: "Arial", sz: 10, b: true, alignment: { horizontal: :center, vertical: :center })
ti = s.add_style(bg_color: "1F3864", fg_color: "FFFFFF", font_name: "Arial", sz: 14, b: true, alignment: { horizontal: :center, vertical: :center })
su = s.add_style(bg_color: "F2F2F2", fg_color: "595959", font_name: "Arial", sz: 10, i: true, alignment: { horizontal: :center, vertical: :center })

wb.add_worksheet(name: "Resumen de Banners") do |sheet|
  sheet.add_row ["GlobalMedia — Reporte de Banners Publicitarios", nil, nil, nil, nil, nil, nil, nil, nil], style: [ti,ti,ti,ti,ti,ti,ti,ti,ti]
  sheet.add_row ["Generado: #{Date.today.strftime('%d/%m/%Y')}", nil, nil, nil, nil, nil, nil, nil, nil], style: [su,su,su,su,su,su,su,su,su]
  sheet.add_row []
  sheet.add_row ["ID", "Nombre del Banner", "Cliente", "Tamaño", "Activo", "Expira", "Impresiones", "Clics", "CTR (%)"], style: [h,h,h,h,h,h,h,h,h]

  @banners.each_with_index do |b, i|
    bd = i.even? ? d : a
    bl = i.even? ? dl : al
    imp    = b.impressions.to_i
    clicks = b.clicks.to_i
    ctr    = imp > 0 ? (clicks.to_f / imp * 100).round(3) : 0
    cs     = ctr >= 1.0 ? g : bd

    sheet.add_row [
      b.id, b.name, b.client, b.size,
      b.active? ? "Sí" : "No",
      b.expiry_date&.strftime('%d/%m/%Y'),
      imp, clicks, "#{ctr}%"
    ], style: [bd, bl, bl, bd, bd, bd, bd, bd, cs]
  end

  total_imp    = @banners.sum { |b| b.impressions.to_i }
  total_clicks = @banners.sum { |b| b.clicks.to_i }
  total_ctr    = total_imp > 0 ? (total_clicks.to_f / total_imp * 100).round(3) : 0

  sheet.add_row ["TOTALES", nil, nil, nil, nil, nil, total_imp, total_clicks, "#{total_ctr}%"],
    style: [t,t,t,t,t,t,t,t,t]

  sheet.merge_cells "A1:I1"
  sheet.merge_cells "A2:I2"
  sheet.column_widths 10, 35, 28, 12, 10, 14, 15, 10, 12
end

wb.add_worksheet(name: "Por Cliente") do |sheet|
  t2 = s.add_style(bg_color: "1F3864", fg_color: "FFFFFF", font_name: "Arial", sz: 13, b: true, alignment: { horizontal: :center, vertical: :center })

  sheet.add_row ["Rendimiento Agrupado por Cliente", nil, nil, nil, nil, nil], style: [t2,t2,t2,t2,t2,t2]
  sheet.add_row []
  sheet.add_row ["Cliente", "Banners Activos", "Total Impresiones", "Total Clics", "CTR Promedio (%)", "Mejor Banner"], style: [h,h,h,h,h,h]

  @banners.group_by(&:client).each_with_index do |(client, bans), i|
    bd = i.even? ? d : a
    bl = i.even? ? dl : al
    total_i = bans.sum { |b| b.impressions.to_i }
    total_c = bans.sum { |b| b.clicks.to_i }
    ctr     = total_i > 0 ? (total_c.to_f / total_i * 100).round(3) : 0
    best    = bans.max_by { |b| b.clicks.to_i }&.name

    sheet.add_row [client, bans.count, total_i, total_c, "#{ctr}%", best],
      style: [bl, bd, bd, bd, bd, bl]
  end

  sheet.merge_cells "A1:F1"
  sheet.column_widths 30, 18, 22, 15, 20, 38
end
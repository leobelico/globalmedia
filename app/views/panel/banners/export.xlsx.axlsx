wb = xlsx_package.workbook

wb.add_worksheet(name: "Resumen de Banners") do |sheet|
  sheet.add_row ["ID", "Nombre del Banner", "Cliente", "Tamaño", "Activo", "Expira", "Impresiones", "Clics", "CTR (%)"]

  @banners.each do |b|
    imp    = b.impressions.to_i
    clicks = b.clicks.to_i
    ctr    = imp > 0 ? (clicks.to_f / imp * 100).round(3) : 0

    sheet.add_row [
      b.id, b.name, b.client, b.size,
      b.active? ? "Sí" : "No",
      b.expiry_date&.strftime('%d/%m/%Y'),
      imp, clicks, "#{ctr}%"
    ]
  end

  total_imp    = @banners.sum { |b| b.impressions.to_i }
  total_clicks = @banners.sum { |b| b.clicks.to_i }
  total_ctr    = total_imp > 0 ? (total_clicks.to_f / total_imp * 100).round(3) : 0

  sheet.add_row ["TOTALES", nil, nil, nil, nil, nil, total_imp, total_clicks, "#{total_ctr}%"]
  sheet.column_widths 10, 35, 28, 12, 10, 14, 15, 10, 12
end

wb.add_worksheet(name: "Por Cliente") do |sheet|
  sheet.add_row ["Cliente", "Banners Activos", "Total Impresiones", "Total Clics", "CTR Promedio (%)", "Mejor Banner"]

  @banners.group_by(&:client).each do |client, bans|
    total_i = bans.sum { |b| b.impressions.to_i }
    total_c = bans.sum { |b| b.clicks.to_i }
    ctr     = total_i > 0 ? (total_c.to_f / total_i * 100).round(3) : 0
    best    = bans.max_by { |b| b.clicks.to_i }&.name

    sheet.add_row [client, bans.count, total_i, total_c, "#{ctr}%", best]
  end

  sheet.column_widths 30, 18, 22, 15, 20, 38
end
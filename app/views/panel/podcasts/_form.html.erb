<link rel="stylesheet" href="/assets/libraries/fontawesome/css/all.min.css">

<form id="fields-for-s3" action="<%= @s3_direct_post.url %>" method="post" enctype="multipart/form-data" style="display:none;">
  <% @s3_direct_post.fields.each do |name, value| %>
    <input type="hidden" name="<%= name %>" value="<%= value %>" />
  <% end %>
</form>

<%= form_for [:panel, @station, @podcast], multipart: true, authenticity_token: true, html: { class: "card admin-form directUpload", remote: true, data: { 'form-data' => (@s3_direct_post.fields), 'url' => @s3_direct_post.url, 'host' => URI.parse(@s3_direct_post.url).host }} do |f| %>
  <% if @podcast.errors.any? %>
    <h5 class="small-title"><%= pluralize(@podcast.errors.count, "errores") %></h5>
    <ul class="errors">
      <% @podcast.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  <% end %>

  <div class="field field--string">
    <label>Nombre del Podcast: </label>
    <%= f.text_field :name %>
  </div>

  <div class="field field--string">
    <label>Descripción: </label>
    <%= f.text_area :description %>
  </div>

  <div class="field field--string">
    <label>Archivo del stream: <i class="icon-uploading fas fa-spinner fa-spin"></i></label>
    <input type="file" id="awsS3File" accept="audio/*">

    <%= f.text_field :stream_url %>
  </div>
<% end %>


<script type="text/javascript">
  // Función para subir archivo a AWS S3 usando el formulario oculto fields-for-s3
// Función corregida para manejar la respuesta XML de S3
function uploadAWSS3(file) {
  return {
    subscribe: function(successCallback, errorCallback) {
      const form = document.getElementById('fields-for-s3');
      const formData = new FormData(form);
      const action = form.action;

      // Actualizar la key con el nombre real del archivo
      const keyInput = form.querySelector('input[name="key"]');
      const originalKey = keyInput.value;
      const actualKey = originalKey.replace('${filename}', file.name);
      formData.set('key', actualKey);
      formData.append('Content-Type', file.type);
      formData.append('file', file);

      const xhr = new XMLHttpRequest();
      xhr.open('POST', action, true);

      xhr.onload = function () {
        console.log('Respuesta completa de S3:', xhr.responseText); // Para debug
        
        // S3 responde con XML siempre, necesitamos parsearlo
        if (xhr.status === 201) { // 201 = Success en S3
          try {
            const parser = new DOMParser();
            const xmlDoc = parser.parseFromString(xhr.responseText, "text/xml");
            
            // Buscar la URL en la respuesta XML
            const locationElement = xmlDoc.getElementsByTagName("Location")[0];
            
            if (locationElement && locationElement.textContent) {
              successCallback(locationElement.textContent);
            } else {
              // Si no encuentra Location, construir la URL manualmente
              const bucketUrl = action.split('/').slice(0, -1).join('/');
              successCallback(bucketUrl + '/' + encodeURIComponent(actualKey));
            }
          } catch (e) {
            // Fallback si el XML parsing falla
            const bucketUrl = action.split('/').slice(0, -1).join('/');
            successCallback(bucketUrl + '/' + encodeURIComponent(actualKey));
          }
        } else {
          // Manejar errores reales de S3
          try {
            const parser = new DOMParser();
            const xmlDoc = parser.parseFromString(xhr.responseText, "text/xml");
            const errorCode = xmlDoc.getElementsByTagName("Code")[0];
            const errorMessage = xmlDoc.getElementsByTagName("Message")[0];
            
            const errorMsg = errorCode && errorMessage 
              ? `${errorCode.textContent}: ${errorMessage.textContent}`
              : `Error S3: ${xhr.status}`;
              
            errorCallback(errorMsg);
          } catch (e) {
            errorCallback('Error desconocido: ' + xhr.status);
          }
        }
      };

      xhr.onerror = function () {
        errorCallback('Error de red al conectar con S3.');
      };

      xhr.send(formData);
    }
  };
}

  $(document).ready(() => {
    const iconUploading = $(`.icon-uploading`);
    iconUploading.hide();

    // Cuando el usuario selecciona un archivo
    $(`#awsS3File`).on('change', (event) => {
      const files = event.target.files;
      if (files.length > 0 ) {
        iconUploading.show();
        uploadAWSS3(files[0]).subscribe(urlPath => {
          iconUploading.hide();
          $('#podcast_stream_url').val(urlPath);
          $('#console').html(`<a href="${urlPath}" target="_blank">Archivo subido: ${urlPath}</a>`);
        }, error => {
          iconUploading.hide();
          $('#console').text(error);
          alert(error);
        });
      }
    });

    // Inicializar Plupload para botón manual
    var uploader = new plupload.Uploader({
      runtimes : 'html5,flash,silverlight,html4',
      browse_button : 'pickfiles',
      container: document.getElementById('container'),
      url : 'upload.php', // si no usas upload.php con plupload, esto debería cambiarse o removerse
      filters : {
        max_file_size : '1024mb'
      },
      init: {
        PostInit: function() {
          document.getElementById('filelist').innerHTML = '';

          document.getElementById('uploadfiles').onclick = function() {
            uploader.start();
            return false;
          };
        },
        FilesAdded: function(up, files) {
          plupload.each(files, function(file) {
            document.getElementById('filelist').innerHTML +=
              '<div id="' + file.id + '">' + file.name + ' (' + plupload.formatSize(file.size) + ') <b></b></div>';
          });
        },
        UploadProgress: function(up, file) {
          document.getElementById(file.id).getElementsByTagName('b')[0].innerHTML = '<span>' + file.percent + "%</span>";
        },
        Error: function(up, err) {
          document.getElementById('console').innerHTML = "Error #" + err.code + ": " + err.message;
        }
      }
    });

    uploader.init();
  });
</script>

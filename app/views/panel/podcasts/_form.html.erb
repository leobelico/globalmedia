<link rel="stylesheet" href="/assets/libraries/fontawesome/css/all.min.css">

<form id="fields-for-s3" action="<%= @s3_direct_post.url %>" method="post" enctype="multipart/form-data" style="display:none;">
  <% @s3_direct_post.fields.each do |name, value| %>
    <input type="hidden" name="<%= name %>" value="<%= value %>" />
  <% end %>
</form>

<%= form_for [:panel, @station, @podcast], multipart: true, authenticity_token: true, html: { class: "card admin-form directUpload", remote: true, data: { 'form-data' => (@s3_direct_post.fields), 'url' => @s3_direct_post.url, 'host' => URI.parse(@s3_direct_post.url).host }} do |f| %>
  <% if @podcast.errors.any? %>
    <h5 class="small-title"><%= pluralize(@podcast.errors.count, "errores") %></h5>
    <ul class="errors">
      <% @podcast.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  <% end %>

  <div class="field field--string">
    <label>Nombre del Podcast: </label>
    <%= f.text_field :name %>
  </div>

  <div class="field field--string">
    <label>Descripción: </label>
    <%= f.text_area :description %>
  </div>

  <div class="field field--string">
    <label>Archivo del stream: <i class="icon-uploading fas fa-spinner fa-spin"></i></label>
    <input type="file" id="awsS3File" accept="audio/*">
    <div style="border: 1px solid #000; margin: 1rem;">
      <div id="filelist">Your browser doesn't have Flash, Silverlight or HTML5 support.</div>
      <div id="container">
        <a id="pickfiles" href="javascript:;">[Selecciona un archivo]</a>
        <a id="uploadfiles" href="javascript:;">[Subir Archivo]</a>
      </div>
      <span id="console"></span>
    </div>
    <%= f.text_field :stream_url %>
  </div>
<% end %>

<script src="/assets/libraries/js/plupload.full.min.js"></script>

<script type="text/javascript">
  // Función para subir archivo a AWS S3 usando el formulario de fields-for-s3
  function uploadAWSS3(file) {
    return {
      subscribe: function(successCallback, errorCallback) {
        const form = document.getElementById('fields-for-s3');
        const formData = new FormData(form);
        const action = form.action;

        formData.append('file', file);

        const xhr = new XMLHttpRequest();
        xhr.open('POST', action, true);

        xhr.onload = function () {
          if (xhr.status === 204 || xhr.status === 200) {
            // La URL final es la URL del bucket + key (nombre de archivo)
            const url = action + '/' + encodeURIComponent(file.name);
            successCallback(url);
          } else {
            errorCallback('Error al subir archivo a S3.');
          }
        };

        xhr.onerror = function () {
          errorCallback('Error de red al subir a S3.');
        };

        xhr.send(formData);
      }
    };
  }

  $(document).ready(() => {
    const iconUploading = $(`.icon-uploading`);
    iconUploading.hide();

    // Evento cuando seleccionas archivo
    $(`#awsS3File`).on('change', (event) => {
      const files = event.target.files;
      if (files.length > 0 ) {
        iconUploading.show();
        uploadAWSS3(files[0]).subscribe(urlPath => {
          iconUploading.hide();
          $('#podcast_stream_url').val(urlPath);
        }, error => {
          iconUploading.hide();
          alert(error);
        });
      }
    });

    // Inicializar Plupload para el boton manual (si quieres seguir usando plupload)
    var uploader = new plupload.Uploader({
      runtimes : 'html5,flash,silverlight,html4',
      browse_button : 'pickfiles', // id del botón para seleccionar archivo
      container: document.getElementById('container'), // contenedor del uploader
      url : 'upload.php', // aquí si no usas upload.php, debería apuntar a tu endpoint de subida, pero como usas S3 directo, probablemente no lo uses
      filters : {
        max_file_size : '1024mb'
      },
      init: {
        PostInit: function() {
          document.getElementById('filelist').innerHTML = '';

          document.getElementById('uploadfiles').onclick = function() {
            uploader.start();
            return false;
          };
        },
        FilesAdded: function(up, files) {
          plupload.each(files, function(file) {
            document.getElementById('filelist').innerHTML +=
              '<div id="' + file.id + '">' + file.name + ' (' + plupload.formatSize(file.size) + ') <b></b></div>';
          });
        },
        UploadProgress: function(up, file) {
          document.getElementById(file.id).getElementsByTagName('b')[0].innerHTML = '<span>' + file.percent + "%</span>";
        },
        Error: function(up, err) {
          document.getElementById('console').innerHTML = "Error #" + err.code + ": " + err.message;
        }
      }
    });

    uploader.init();
  });
</script>

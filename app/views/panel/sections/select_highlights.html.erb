<div class="panel__header">
  <h2 class="title panel__title">Sección / <span class="current">Escoger destacado</span></h2>
</div>

<%= form_with url: set_highlight_panel_section_path(@section.slug), method: :post, html: { class: "card admin-form" }, local: true do |f| %>
  <div class="field">
    <%= f.autocomplete_field :article_id, autocomplete_article_name_panel_sections_path, id_element: '#article_id_hidden', class: "search-bar", placeholder: "Buscar Artículo", type: "search" %>
    <%= f.hidden_field :article_id, id: "article_id_hidden" %>
  </div>

  <%= f.submit "Escoger artículo", class: "button" %>
<% end %>

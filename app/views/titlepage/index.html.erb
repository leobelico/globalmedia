<% content_for :title, "Global Media - Noticias" %>
<!-- Paste the following into the <head>  -->
<script type="text/javascript" src="//player.wowza.com/player/latest/wowzaplayer.min.js"></script>

<style>
    #clappr{ width: 100%;height: 100%;position: relative; min-height: 320px; margin-bottom: 25px;}
    #clappr > div{ width:100%;height:100%;position: absolute;}
</style>

<style>
    .enc-links {
        display:  flex;
        flex-direction:  row;
        align-items:  stretch;
        justify-content:  center;
        width:  100%;
    }
    .enc-links a {
        width:  100%;
    }
    .enc-links img {
        height:  auto;
        width:  100%;
        flex-shrink: 0;
    }
    @media screen and (max-width:  1024px) {
        .enc-links {
            flex-direction:  column;
        }
        .enc-links a {
            width:  100%;
            max-width:  400px;
            margin:  0 auto;
        }
    }
</style>

<style>
    .banner-wide {
        display: flex;
        width:  100%;
        height:  auto;
    }
    .banner-wide img {
        width:  100%;
        height:  auto;
        margin-bottom: 15px;
    }
    .banner-ww {
        width: 100%;
        height:  auto;
    }
    .banner-ww img {
        width:  100%;
        height:  auto;
    }
</style>

<%# cache @breaking_news do %>
  <%# if @breaking_news.count > 0 %>
    <%#= render "components/breaking-news" %>
  <%# end %>
<%# end %>

<% if @highlights.present? %>
  <div class="highlights-container">
    <% @highlights.each do |highlight| %>
      <% if highlight.order == 1 %>
        <%= render "components/principal-highlight", article: highlight.article %>
      <% else %>
        <%= render "components/secondary-highlight", article: highlight.article %>
      <% end %>
    <% end %>
  </div>
<% else %>
  <p>No hay highlights disponibles.</p>
<% end %>

<% cache(get_banner("global", "TitlePage", "Grande")) do %>
  <% if get_banner("global", "TitlePage", "Grande")&.count.to_i > 0 %>
    <%= render "components/big-banner", banner: get_banner("global", "TitlePage", "Grande") %>
  <% end %>
<% end %>

<div class="special-articles-container">
  <div class="special-articles d-flex" style="width: 100% !important;">
    <% cache(latest_news) do %>
      <%= render "components/latest-news", articles: latest_news %>
    <% end %>
    <% if get_banner("", "TitlePage", "Chico")&.count.to_i > 0 %>
      <%= render "components/small-banner", banner: get_banner("", "TitlePage", "Chico") %>
    <% elsif get_banner("", "Global", "Chico")&.count.to_i > 0 %>
      <%= render "components/small-banner", banner: get_banner("", "Global", "Chico") %>
    <% end %>
  </div>
  <div class="special-articles--collaborators">
    <%= render "components/collaborators", articles: get_collaborators || [] %>
  </div>
</div>

<div class="section-previews-container">
  <%# San-Luis primero %>
  <% san_luis_section = @sections.find_by(name: "San-Luis") %>
  <% if san_luis_section %>
    <% cache(get_cover_articles(san_luis_section.id)) do %>
      <%= render "/layouts/cover_section_preview", articles: get_cover_articles(san_luis_section.id) %>
    <% end %>
  <% end %>

  <%# Denuncia Urbana segundo %>
  <% denuncia_urbana_section = @sections.find_by(name: "Denuncia Urbana") %>
  <% if denuncia_urbana_section %>
    <% cache(get_cover_articles(denuncia_urbana_section.id)) do %>
      <%= render "/layouts/cover_section_preview", articles: get_cover_articles(denuncia_urbana_section.id) %>
    <% end %>
  <% end %>

  <%# Las demás secciones %>
  <% otras_secciones = @sections.where.not(name: ["San-Luis", "Denuncia Urbana"]) %>
  <% otras_secciones.each do |section| %>
    <% cache(get_cover_articles(section.id)) do %>
      <%= render "/layouts/cover_section_preview", articles: get_cover_articles(section.id) %>
    <% end %>
  <% end %>
</div>

<% if get_banner("", "TitlePage", "Grande")&.count.to_i > 0 %>
  <%= render "components/big-banner", banner: get_banner("", "TitlePage", "Grande") %>
<% elsif get_banner("", "Global", "Grande")&.count.to_i > 0 %>
  <%= render "components/big-banner", banner: get_banner("", "Global", "Grande") %>
<% end %>
